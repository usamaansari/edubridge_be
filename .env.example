# -----------------------------------------------------------------------------
# Database (required)
# Local: postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
# Remote: append ?sslmode=require if your host requires TLS
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# HTTP server (optional)
# Defaults to 3011 if unset
# -----------------------------------------------------------------------------
PORT=3011

# Optional: base URL shown in Swagger UI (defaults to http://localhost:PORT)
# SWAGGER_SERVER_URL=http://localhost:3011

# -----------------------------------------------------------------------------
# App environment (optional)
# development | production | test — affects cookie "secure" flag and JWT rules
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Auth — JWT signing secret
# Required when NODE_ENV=production. In development, a built-in dev secret is
# used if this is empty (not safe for real data).
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=

# Access token lifetime (jsonwebtoken format: 15m, 1h, 7d). The frontend keeps a
# 7-day session without refreshing, so keep this at 7d unless that changes.
ACCESS_TOKEN_TTL=7d
# Refresh tokens are rotated on every use
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# OTP (email/phone verification, OTP login, password reset)
# In development the code is printed to the server console.
# -----------------------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# File uploads (stored on local disk, served at /uploads)
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
# Public URL used to build links to uploaded files
PUBLIC_BASE_URL=http://localhost:3011
